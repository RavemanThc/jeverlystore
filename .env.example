# Copy to .env.local. Public Firebase Web config only; NEVER put service-account keys here.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Base URL including /api if needed. GET {base}/products returns { products: Product[] }.
# Leave empty to show explicitly labeled demo products.
NEXT_PUBLIC_API_URL=
